{
  "name": "Toolnest - Developer Toolbox",
  "short_name": "Toolnest",
  "description": "Privacy-first offline developer toolbox with 25+ essential tools.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#121318",
  "theme_color": "#6366f1",
  "orientation": "any",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "JSON Formatter",
      "url": "/tools/json-formatter",
      "description": "Validate and prettify JSON payloads"
    },
    {
      "name": "REST API Playground",
      "url": "/tools/rest-api-client",
      "description": "Compose and test HTTP REST APIs"
    },
    {
      "name": "Subnet Calculator",
      "url": "/tools/subnet-calculator",
      "description": "CIDR and IPv4 subnet planner"
    },
    {
      "name": "SVG Optimizer",
      "url": "/tools/svg-optimizer",
      "description": "Minify and clean SVG markup"
    }
  ]
}
